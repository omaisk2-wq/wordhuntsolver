---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  schema?: Record<string, any> | Record<string, any>[];
  noindex?: boolean;
}

const { title, description, path, ogImage, schema, noindex } = Astro.props;

const siteWideSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Word Hunt Solver",
    url: "https://www.wordhuntsolvers.com/",
    logo: "https://www.wordhuntsolvers.com/favicon.svg",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Word Hunt Solver",
    url: "https://www.wordhuntsolvers.com/",
  },
];

const pageSchema = Array.isArray(schema) ? schema : schema ? [schema] : [];
const allSchema = [...siteWideSchema, ...pageSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo title={title} description={description} path={path} ogImage={ogImage} schema={allSchema} noindex={noindex} />
    <script is:inline>
      // Runs before paint to avoid a flash of the wrong theme.
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const dark = stored ? stored === "dark" : prefersDark;
        document.documentElement.classList.toggle("dark", dark);
      })();

      // Always land at the top of the page on a fresh navigation. If the browser
      // is restoring this tab instantly from its own cache (bfcache), leave it
      // alone so that fast native restore is not interrupted.
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }
      window.addEventListener("pageshow", (event) => {
        if (!event.persisted) {
          window.scrollTo(0, 0);
        }
      });
    </script>

    <!-- Google Search Console / Analytics site verification tag goes here -->
    <!-- Paste the full <meta name="google-site-verification" content="..." /> tag on the next line -->
<meta name="google-site-verification" content="e3Z0qdUQt0Ecdqorbtv1pnjIguaOCWbhwFn-D8s0kbw" />

  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
