---
import { TOOLS } from "../data/site";

interface Props {
  exclude?: string;
  headingTag?: "h2" | "h3" | "p";
}
const { exclude, headingTag = "h3" } = Astro.props;
const items = TOOLS.filter((t) => t.href !== exclude);
const Tag = headingTag;
const icons = {
  grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  chart: '<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>',
};
---

<div class={`grid gap-5 ${items.length > 1 ? "sm:grid-cols-2" : ""}`}>
  {
    items.map((t) => (
      <a href={t.href} class="card-link group flex-row items-start gap-4 p-5 sm:p-6">
        <span class="inline-flex h-12 w-12 flex-none items-center justify-center rounded-xl bg-headline text-white dark:bg-headline-dark dark:text-brand-900">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-6 w-6" set:html={icons[t.icon]} />
        </span>
        <span class="flex flex-1 flex-col">
          <span class="card-kicker">Free tool</span>
          <Tag class="mt-1 text-lg font-bold text-gray-900 group-hover:text-headline dark:text-white dark:group-hover:text-headline-dark">{t.title}</Tag>
          <span class="mt-1.5 block text-[0.9375rem] leading-relaxed text-gray-600 dark:text-gray-300">{t.description}</span>
          <span class="read-more pt-3">
            {t.cta}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4 transition-transform group-hover:translate-x-0.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </span>
        </span>
      </a>
    ))
  }
</div>
