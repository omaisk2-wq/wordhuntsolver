---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found | Word Hunt Solver"
  description="The page you were looking for could not be found."
  path="/404"
  noindex={true}
>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-20 text-center">
    <p class="text-6xl font-extrabold text-headline dark:text-headline-dark">404</p>
    <h1 class="mt-4 text-3xl font-extrabold text-gray-900 dark:text-white">This Page Could Not Be Found</h1>
    <p class="mt-3 text-gray-600 dark:text-gray-300">The link may be old, or the page may have moved.</p>
    <a href="/" class="btn-accent mt-8">Return to Homepage</a>
  </section>
</Layout>
