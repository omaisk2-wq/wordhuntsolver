---
import Layout from "../../layouts/Layout.astro";
import GuideCards from "../../components/GuideCards.astro";
import ToolCards from "../../components/ToolCards.astro";
const schema = [
 {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Word Hunt Guides",
  "url": "https://www.wordhuntsolvers.com/guides",
  "inLanguage": "en-US",
  "mainEntity": {
   "@type": "ItemList",
   "itemListElement": [
    {
     "@type": "ListItem",
     "position": 1,
     "url": "https://www.wordhuntsolvers.com/guides/word-hunt-cheat",
     "name": "Word Hunt Cheat Guide"
    },
    {
     "@type": "ListItem",
     "position": 2,
     "url": "https://www.wordhuntsolvers.com/guides/word-hunt-tips",
     "name": "How to Win at Word Hunt"
    },
    {
     "@type": "ListItem",
     "position": 3,
     "url": "https://www.wordhuntsolvers.com/guides/word-hunt-solver-vs-word-finder",
     "name": "Word Hunt Solver vs Word Finder vs Word Search Solver"
    },
    {
     "@type": "ListItem",
     "position": 4,
     "url": "https://www.wordhuntsolvers.com/evolver",
     "name": "Board Evolver"
    }
   ]
  }
 },
 {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
   {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://www.wordhuntsolvers.com/"
   },
   {
    "@type": "ListItem",
    "position": 2,
    "name": "Guides",
    "item": "https://www.wordhuntsolvers.com/guides"
   }
  ]
 }
];
---

<Layout
  title="Word Hunt Guides: Strategy, Fair Play, and Tools"
  description="Every Word Hunt guide in one place: how to win more rounds, fair ways to use a solver, which word tool fits your puzzle, and practice boards."
  path="/guides"
  schema={schema}
>
  <article class="mx-auto max-w-6xl px-4 pb-14 pt-6 sm:px-6 sm:pt-10">
    <header id="top" class="scroll-mt-24">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-brand-400 dark:text-brand-300"><a href="/" class="hover:text-headline">Home</a> / <span aria-current="page">Guides</span></nav>
<h1 class="text-3xl font-extrabold leading-[1.15] text-headline dark:text-headline-dark sm:text-4xl lg:text-[2.75rem]">Word Hunt Guides</h1>
<p class="mt-3 text-gray-600 dark:text-gray-300">Practical guides for GamePigeon Word Hunt players, from fair play to finding longer words. Each guide answers one topic in depth.</p>
    </header>
<section id="guides" class="scroll-mt-24 py-7 sm:py-9">
<div class="mb-4 flex items-center gap-3"><span class="section-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5v14z"/><path d="M6.5 17A2.5 2.5 0 0 0 4 19.5 2.5 2.5 0 0 0 6.5 22H20v-5"/></svg></span><h2 class="text-2xl font-extrabold leading-tight text-gray-900 sm:text-[1.75rem] dark:text-white">Guides for Word Hunt Players</h2></div>
<p class="mt-2 text-gray-600 dark:text-gray-300">Start with the strategy guide if you want to win more rounds. Read the cheat guide to learn when a solver is fair, and the comparison guide if you're not sure which word tool fits your puzzle.</p>
<div class="mt-6"><GuideCards /></div>
</section>
<section id="tools" class="scroll-mt-24 py-7 sm:py-9">
<div class="mb-4 flex items-center gap-3"><span class="section-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span><h2 class="text-2xl font-extrabold leading-tight text-gray-900 sm:text-[1.75rem] dark:text-white">Free Word Hunt Tools</h2></div>
<p class="mt-2 text-gray-600 dark:text-gray-300">Use the solver to check every word on a board you just played. Use the Board Evolver to build high scoring boards for practice. Both run in your browser with no signup.</p>
<div class="mt-6"><ToolCards /></div>
</section>
  </article>
</Layout>
