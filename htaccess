RewriteEngine On

RewriteRule ^guides/?$ guides.html [L]

# 1. Force https AND www together.
# Catches: http://wordhuntsolvers.com, https://wordhuntsolvers.com, http://www.wordhuntsolvers.com
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.wordhuntsolvers.com/$1 [L,R=301]

# 2. Redirect any URL with a trailing slash (except the homepage) to the same
# URL without it, e.g. /evolver/ -> /evolver
RewriteCond %{THE_REQUEST} \s/+(.+?)/+[?\s] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Redirect any URL with a literal .html extension to the clean URL without
# it, e.g. /evolver.html -> /evolver
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[?\s] [NC]
RewriteRule ^ /%1 [R=301,L]

# 4. Internally serve the matching .html file for a clean URL, without
# changing what shows in the browser's address bar.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]
